# 仅用于显示完整地址；留空则返回通用的 /access/<token> 路径。
# Optional display URL only; leave empty to get a reusable /access/<token> path.
PUBLIC_BASE_URL=
PDF2ZH_IMAGE=wangtengzhou/zotero-pdf2zh-next:0.1.3
# 同机原生运行的 Lucky 可以访问此回环端口。
# Same-host native Lucky can reach this loopback port.
# 如需局域网直连或 Lucky 在其他设备上运行，请使用服务器内网地址。
# For direct LAN access or Lucky on another device, use the server LAN address.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8890
MAX_UPLOAD_MB=100
UPSTREAM_TIMEOUT_SECONDS=3600
TZ=Asia/Shanghai
