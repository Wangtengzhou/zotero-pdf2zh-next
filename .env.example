# Optional display URL only; leave empty to get a reusable /access/<token> path.
PUBLIC_BASE_URL=
PDF2ZH_IMAGE=wangtengzhou/zotero-pdf2zh-next:0.1.2
# Same-host native Lucky can reach this loopback port.
# For Lucky on another device, use the server LAN address and restrict access.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8890
MAX_UPLOAD_MB=100
UPSTREAM_TIMEOUT_SECONDS=3600
TZ=Asia/Shanghai
